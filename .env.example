# Postgres (Neon): copie a connection string "pooled" do painel do Neon
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Segredo para assinar os cookies das salas (gere com: openssl rand -base64 32)
SESSION_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# PIN inicial (4 dígitos) do administrador. Entre com o código "admin" na tela inicial.
# Só é usado no primeiro login; depois o PIN pode ser trocado no painel /admin.
ADMIN_PIN="0000"
